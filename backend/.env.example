# Application Settings
PROJECT_NAME="Brightloop Subscription Management System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security
SECRET_KEY="replace_this_with_a_super_secret_key_in_production_run_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL by default, or sqlite:///./subscription.db for local test)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_management"
# DATABASE_URL="sqlite:///./subscription.db"

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "http://127.0.0.1:3000"]'

# Default Admin Seed Credentials
FIRST_SUPERUSER_EMAIL="admin@brightloop.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword@123"
FIRST_SUPERUSER_NAME="System Administrator"

